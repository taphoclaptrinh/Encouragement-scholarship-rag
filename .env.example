# Google Gemini API Key (Lấy tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Sinh văn bản & Suy luận cho Agent Loop:
# Lựa chọn tối ưu: gemini-3.8-flash (mới nhất), gemini-flash-latest, gemini-3.5-flash
# (Lưu ý: gemini-1.5-flash, gemini-2.0-flash, gemini-2.5-flash đã bị Google giới hạn/ngừng hỗ trợ cho key mới)
GEMINI_MODEL=gemini-3.8-flash

# Model Vector Embeddings cho RAG:
# Lựa chọn: gemini-embedding-001 (chuẩn text), gemini-embedding-2 (multimodal)
# (Lưu ý: text-embedding-004 đã chính thức ngừng hoạt động từ tháng 1/2026)
EMBEDDING_MODEL=gemini-embedding-001

# Agent Config
MAX_AGENT_STEPS=8
AGENT_TEMPERATURE=0.1
